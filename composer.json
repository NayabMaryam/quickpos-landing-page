{
    "name": "nayabmaryam/quickpos-landing-page",
    "description": "QuickPOS Landing Page with PHPUnit tests and CI/CD pipeline",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload-dev": {
        "psr-4": {
            "QuickPOS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit tests/ --testdox",
        "test-with-report": "php run-tests-with-report.php",
        "cs-check": "phpcs --standard=PSR12 --ignore=vendor/,index.php,run-tests-with-report.php,tests/TestReport.php .",
        "cs-fix": "vendor/bin/phpcbf --standard=PSR12 --ignore=vendor/,index.php,run-tests-with-report.php,tests/TestReport.php ."
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}